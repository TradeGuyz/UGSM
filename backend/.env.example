# Used to unlock the app until a PIN is set in Settings. 6 to 12 digits.
APP_PIN=

# Signs login cookies so they survive restarts. Required on Cloud Run. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Same value as API_SIGNATURE_TOKEN in Netlify's environment variables. When set, the API only
# accepts requests proxied (and signed) by the Netlify site. Required on Cloud Run; leave unset locally.
# API_SIGNATURE_TOKEN=
