# Where the dev server sends /api requests. Defaults to the backend on http://localhost:3001.
# API_URL=http://localhost:3001

# To use the live API (real PIN, real collections, real uploads), point it at the deployed
# Netlify site, not at Cloud Run: the API only accepts requests Netlify has signed.
# Put this in .env.local, then restart `npm run dev`.
# API_URL=https://your-site.netlify.app
